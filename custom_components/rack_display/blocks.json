{
  "version": 1,
  "blocks": {
    "header": {
      "name": "Header",
      "size": "full",
      "desc": "Name, model, position, front image, up to 4 key figures",
      "items": true,
      "group": "kopf"
    },
    "tiles": {
      "name": "Current values",
      "size": "full",
      "desc": "Tiles with the key measurements",
      "group": "werte"
    },
    "values": {
      "name": "Values",
      "size": "full",
      "desc": "Any entities as tiles",
      "items": true,
      "group": "werte"
    },
    "entity": {
      "name": "Single value",
      "size": "half",
      "desc": "One value as its own tile – optionally with a 24 h curve",
      "items": true,
      "group": "werte"
    },
    "bars": {
      "name": "Bars",
      "size": "half",
      "desc": "Load as bars (0–100 % or custom range)",
      "items": true,
      "group": "werte"
    },
    "status": {
      "name": "Status",
      "size": "half",
      "desc": "States as a list with traffic lights",
      "items": true,
      "group": "zustand"
    },
    "ports": {
      "name": "Ports",
      "size": "full",
      "desc": "All ports with speed, PoE and live throughput",
      "group": "netzwerk"
    },
    "poe": {
      "name": "PoE",
      "size": "half",
      "desc": "PoE power in total and per port",
      "group": "netzwerk"
    },
    "system": {
      "name": "System",
      "size": "half",
      "desc": "CPU, RAM and temperature over 24 h",
      "slots": [
        "cpu",
        "ram",
        "cpu_temp"
      ],
      "group": "system"
    },
    "internet": {
      "name": "Internet",
      "size": "half",
      "desc": "Download and upload over 24 h",
      "slots": [
        "wan_down",
        "wan_up"
      ],
      "group": "netzwerk"
    },
    "flow": {
      "name": "Energy flow",
      "size": "full",
      "desc": "Online UPS: mains, battery, load",
      "group": "strom"
    },
    "voltage": {
      "name": "Voltage",
      "size": "half",
      "desc": "Input and output voltage over 24 h",
      "slots": [
        "input_voltage",
        "output_voltage"
      ],
      "group": "strom"
    },
    "chart": {
      "name": "History",
      "size": "half",
      "desc": "One to three measurements over 24 h",
      "slots": [
        "source"
      ],
      "items": true,
      "group": "diagramme"
    },
    "outlets": {
      "name": "Outlets",
      "size": "full",
      "desc": "Outlets of a PDU with assignments",
      "group": "strom"
    },
    "disks": {
      "name": "Disks",
      "size": "full",
      "desc": "Bays, state and usage",
      "group": "speicher"
    },
    "recording": {
      "name": "Recording",
      "size": "half",
      "desc": "Retention, recording types, cameras",
      "group": "speicher"
    },
