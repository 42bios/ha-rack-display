      "name": "Switches",
      "size": "half",
      "desc": "Control switches, lights and fans directly",
      "items": true,
      "group": "steuerung"
    },
    "button": {
      "name": "Actions",
      "size": "half",
      "desc": "Run scripts, scenes and buttons",
      "items": true,
      "group": "steuerung"
    },
    "camera": {
      "name": "Camera",
      "size": "half",
      "desc": "Camera still image (refreshes continuously)",
      "items": true,
      "group": "speicher"
    },
    "heading": {
      "name": "Heading",
      "size": "full",
      "desc": "Title with subtitle for structure",
      "group": "sonstiges"
    },
    "clock": {
      "name": "Clock",
      "size": "half",
      "desc": "Time and date",
      "group": "sonstiges"
    },
    "ov_power": {
      "name": "Power (overview)",
      "size": "full",
      "desc": "Rack power, UPS battery, consumers and 24 h history",
      "group": "uebersicht"
    },
    "ov_temp": {
      "name": "Temperature (overview)",
      "size": "full",
      "desc": "Warmest device and temperatures of all devices",
      "group": "uebersicht"
    },
    "ov_hints": {
      "name": "Notices (overview)",
      "size": "full",
      "desc": "Warnings and faults of all devices",
      "group": "uebersicht"
    },
    "ov_stats": {
      "name": "Key figure bar",
      "size": "full",
      "desc": "Internet, PoE, PDU, UPS at a glance",
      "group": "uebersicht"
    },
    "bays": {
      "name": "Drive bays",
      "size": "full",
      "desc": "Bays with parity, data and cache, temperature, usage and spin-down",
      "items": true,
      "group": "speicher"
    },
    "array": {
      "name": "Array",
      "size": "half",
      "desc": "Usage, state, cache pools and parity of an array",
      "items": true,
      "group": "speicher"
    }
