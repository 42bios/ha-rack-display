      "items": true,
      "group": "werte"
    },
    "progress": {
      "name": "Progress",
      "size": "half",
      "desc": "One value as a bar with min/max",
      "items": true,
      "group": "werte"
    },
    "histogram": {
      "name": "Bar chart",
      "size": "half",
      "desc": "Hourly values of the last 24 h as bars",
      "items": true,
      "group": "diagramme"
    },
    "chips": {
      "name": "Status chips",
      "size": "full",
